# Copy to .env and fill in only if needed. NEVER commit .env.

# --- Optional overrides ---
# LOG_LEVEL=INFO

# Custom browser User-Agent (defaults to a standard Chrome UA)
# USER_AGENT=

# HTTP timeout in seconds
# HTTP_TIMEOUT=25

# --- VPN (OPTIONAL environment dependency) ---
# The app never stores VPN credentials. If you use a US VPN for research,
# configure it at the OS/system level before running. The app can detect
# apparent country via public geo endpoint if reachable; it will not
# rotate servers or bypass restrictions.
# VPN_COUNTRY_EXPECTED=US
